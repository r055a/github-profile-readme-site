---
import "../style.css";

interface TransClient {
  locale: string;
  title: string;
  tagline: string;
  readmeHTML: string;
}

interface Props {
  title: string;
  description?: string;
  url?: URL;
  imageUrl?: string;
  imageAlt?: string;
  language?: string;
  themeCol?: string;
  data?: Record<string, unknown>;
  favUrl?: string;
  noindex?: boolean;
  translations?: TransClient[];
  defLanguage?: string;
}

const {
  title,
  description,
  url,
  imageUrl,
  imageAlt,
  language = "en",
  themeCol,
  data,
  favUrl,
  noindex = false,
  translations = [],
  defLanguage = language,
} = Astro.props;

const baseUrl: string | undefined = url?.href;
const jsonLd: string | undefined = data
  ? JSON.stringify(data).replace(/</g, "\\u003c")
  : undefined;
const i18n: string | undefined =
  translations.length > 1
    ? JSON.stringify({ defLanguage, translations }).replace(/</g, "\\u003c")
    : undefined;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />

    {themeCol && <meta name="theme-color" content={themeCol} />}

    <style is:inline set:html={"html.i18n-pending body { visibility: hidden; }"}
    ></style>

    {
      i18n && (
        <script
          id="i18n-data"
          type="application/json"
          is:inline
          set:html={i18n}
        />
      )
    }

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("i18n-pending");

        const relPage = () => root.classList.remove("i18n-pending");
        const relTimer = window.setTimeout(relPage, 3000);

        try {
          const payloadElement = document.getElementById("i18n-data");
          const payload = JSON.parse(payloadElement?.textContent ?? "{}");
          const localeNorm = (locale) =>
            String(locale ?? "")
              .trim()
              .replaceAll("_", "-")
              .toLowerCase();

          const translations = Array.isArray(payload.translations)
            ? payload.translations
                .map((translation) => ({
                  ...translation,
                  localeNorm: localeNorm(translation?.locale),
                }))
                .filter(
                  (translation) =>
                    translation.localeNorm &&
                    typeof translation.title === "string" &&
                    typeof translation.tagline === "string" &&
                    typeof translation.readmeHTML === "string",
                )
            : [];
          if (!translations.length) {
            window.clearTimeout(relTimer);
            relPage();
            return;
          }

          const localeTrans = new Map(
            translations.map((translation) => [
              translation.localeNorm,
              translation,
            ]),
          );
          const transFB =
            localeTrans.get(localeNorm(payload.defLanguage)) ?? translations[0];

          const transFind = () => {
            const browserLocales =
              Array.isArray(navigator.languages) && navigator.languages.length
                ? navigator.languages
                : [navigator.language];

            for (const browserLoc of browserLocales) {
              const reqLocale = localeNorm(browserLoc);
              if (!reqLocale) continue;

              const exact = localeTrans.get(reqLocale);
              if (exact) return exact;

              const localeParts = reqLocale.split("-");
              for (let len = localeParts.length - 1; len >= 1; len -= 1) {
                const lessSpecific = localeTrans.get(
                  localeParts.slice(0, len).join("-"),
                );
                if (lessSpecific) return lessSpecific;
              }

              const isTrans = translations.find(
                ({ localeNorm }) => localeNorm.split("-")[0] === localeParts[0],
              );
              if (isTrans) return isTrans;
            }
            return transFB;
          };

          const localeDir = (locale) =>
            /^(?:ar|ckb|dv|fa|he|ku|ps|sd|ug|ur)(?:-|$)/i.test(locale)
              ? "rtl"
              : "ltr";

          const applyTrans = (isForceReadme = false) => {
            const translation = transFind();
            if (!translation) return;

            const locale = translation.locale;
            const isLocaleToggled =
              root.dataset.appliedLocale !== translation.localeNorm;
            root.lang = locale;
            root.dir = localeDir(locale);
            root.dataset.locale = locale;
            document.title = translation.title;

            const ogTitle = document.querySelector('meta[property="og:title"]');
            if (ogTitle) {
              ogTitle.setAttribute("content", translation.title);
            }

            const tagline = document.querySelector("[data-i18n-tagline]");
            if (tagline) {
              const value = translation.tagline.trim();
              tagline.textContent = value;
              tagline.hidden = !value;
            }

            const readme = document.querySelector("[data-i18n-readme]");
            if (readme && (isLocaleToggled || isForceReadme)) {
              readme.innerHTML = translation.readmeHTML;
            }

            root.dataset.appliedLocale = translation.localeNorm;
            if (isLocaleToggled || isForceReadme) {
              window.dispatchEvent(
                new CustomEvent("i18n-toggle-readme", {
                  detail: { locale },
                }),
              );
            }
            window.clearTimeout(relTimer);
            relPage();
          };

          const selected = transFind();
          if (selected) {
            root.lang = selected.locale;
            root.dir = localeDir(selected.locale);
            root.dataset.locale = selected.locale;
          }

          if (document.readyState === "loading") {
            document.addEventListener(
              "DOMContentLoaded",
              () => applyTrans(true),
              {
                once: true,
              },
            );
          } else {
            applyTrans(true);
          }

          window.addEventListener("i18n-toggle", () => applyTrans(true));
          window.addEventListener("pageshow", () => applyTrans());
          document.addEventListener("visibilitychange", () => {
            if (!document.hidden) applyTrans();
          });
        } catch (error) {
          window.clearTimeout(relTimer);
          relPage();
          console.error("Failed to select browser language:", error);
        }
      })();
    </script>

    <script is:inline>
      (() => {
        let savedTheme;
        try {
          savedTheme = localStorage.getItem("gh-profile-theme");
        } catch {
          // pass
        }

        const theme =
          savedTheme === "light" || savedTheme === "dark"
            ? savedTheme
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";

        const root = document.documentElement;
        root.dataset.theme = theme;
        root.classList.toggle("dark", theme === "dark");
        root.style.colorScheme = theme;
      })();
    </script>

    <script is:inline>
      const copyIcon = `
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"/>
          <path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"/>
        </svg>
      `;
      const checkIcon = `
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/>
        </svg>
      `;

      const copyButton = () => {
        for (const pre of document.querySelectorAll(".gh-readme pre")) {
          if (pre.querySelector(".copy-code-button")) continue;
          const button = document.createElement("button");
          button.type = "button";
          button.className = "copy-code-button";
          button.ariaLabel = "Copy code to clipboard";
          button.innerHTML = copyIcon;
          pre.append(button);
        }
      };
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", copyButton, {
          once: true,
        });
      } else {
        copyButton();
      }
      window.addEventListener("i18n-toggle-readme", copyButton);

      document.addEventListener("click", async (event) => {
        const button =
          event.target instanceof Element
            ? event.target.closest(".copy-code-button")
            : null;
        if (!(button instanceof HTMLButtonElement)) return;

        const pre = button.closest("pre");
        if (!pre) return;

        const text = pre.querySelector("code")?.innerText ?? pre.innerText;
        try {
          await navigator.clipboard.writeText(text);

          button.innerHTML = checkIcon;
          button.ariaLabel = "Code copied";
          button.classList.add("copied");
          setTimeout(() => {
            button.innerHTML = copyIcon;
            button.ariaLabel = "Copy code to clipboard";
            button.classList.remove("copied");
          }, 2000);
        } catch (error) {
          console.error("Failed to copy code:", error);
        }
      });
    </script>

    <title>{title}</title>
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "max-image-preview:large"}
    />

    <link
      rel="icon"
      href={favUrl ??
        `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon.svg`}
    />

    {
      description && (
        <>
          <meta name="description" content={description} />
          <meta property="og:description" content={description} />
        </>
      )
    }

    {
      baseUrl && (
        <>
          <link rel="canonical" href={baseUrl} />
          <meta property="og:url" content={baseUrl} />
        </>
      )
    }

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />

    {
      imageUrl && (
        <>
          <meta property="og:image" content={imageUrl} />
          {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
        </>
      )
    }

    {
      jsonLd && (
        <script is:inline type="application/ld+json" set:html={jsonLd} />
      )
    }
  </head>

  <body>
    <slot />
  </body>
</html>
