---
import ProfileAvatar from "../components/ProfileAvatar.astro";
import IconLinks from "../components/IconLinks.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

import {
  githubAvatarUrl,
  githubProfileUrl,
  locales,
  localeSrc,
  siteConfig,
} from "../config";
import { getIconLinks, idUrls } from "../lib/links";
import { fetchAvatar } from "../lib/fav";
import { getTranslations, type ProfileTrans } from "../lib/profile";

const { description, githubUsername, links, tabName, themeCol } = siteConfig;
const [translations, favUrl, iconLinks] = await Promise.all([
  Promise.all(
    locales.map(async (locale: string) => {
      const translation: ProfileTrans = await getTranslations(locale);
      return [locale, translation] as const;
    }),
  ),
  fetchAvatar(githubAvatarUrl),
  getIconLinks(links),
]);

const transMap: Map<string, ProfileTrans> = new Map<string, ProfileTrans>(
  translations,
);
const srcProfile: ProfileTrans | undefined = transMap.get(localeSrc);
if (!srcProfile) {
  throw new Error(`Source profile for ${localeSrc} is not found.`);
}

const getTrans = locales.map((locale: string) => {
  const trans: ProfileTrans | undefined = transMap.get(locale);
  if (!trans) {
    throw new Error(`README translation for ${locale} is not found.`);
  }
  return {
    locale,
    title: trans.title,
    tagline: trans.tagline,
    readmeHTML: trans.readme.html,
  };
});

const url: URL = new URL(Astro.url.pathname, Astro.site);
const sameAs: string[] = [...new Set([githubProfileUrl, ...idUrls(iconLinks)])];

const structData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: url.href,
  name: srcProfile.title,
  ...(description && { description }),

  mainEntity: {
    "@type": "Person",
    name: tabName,
    alternateName: githubUsername,
    ...(description && { description }),
    image: githubAvatarUrl,
    url: url.href,
    sameAs,
  },
};
---

<BaseLayout
  title={srcProfile.title}
  description={description}
  url={url}
  imageUrl={githubAvatarUrl}
  imageAlt={`${tabName}'s GitHub profile photo`}
  language={localeSrc}
  themeCol={themeCol}
  data={structData}
  favUrl={favUrl}
  translations={getTrans}
  defLanguage={localeSrc}
>
  <main
    class="content-shell relative mx-auto min-h-screen max-w-4xl px-5 py-10 sm:px-8 sm:py-16"
  >
    <ThemeToggle />

    <ProfileAvatar
      imageUrl={githubAvatarUrl}
      profileUrl={githubProfileUrl}
      tabName={tabName}
      tagline={srcProfile.tagline}
    />

    <IconLinks links={iconLinks} />

    <article
      class="gh-readme prose max-w-none prose-slate dark:prose-invert"
      data-i18n-readme
      set:html={srcProfile.readme.html}
    />
  </main>
</BaseLayout>
---
