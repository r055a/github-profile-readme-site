{
  "name": "github-profile-readme-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "i18n": "node scripts/i18n-trans.mjs",
    "dev": "npm run i18n && astro dev",
    "build": "npm run i18n && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint \"src/**/*.{astro,js,ts}\" \"*.{js,mjs}\"",
    "lint:fix": "eslint \"src/**/*.{astro,js,ts}\" \"*.{js,mjs}\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "quality": "npm run check && npm run lint && npm run format:check",
    "quality:fix": "npm run lint:fix && npm run format && npm run check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@huggingface/transformers": "3.8.1",
    "astro": "^7.1.3",
    "bootstrap-icons": "^1.13.1",
    "clean": "^4.0.2",
    "emoji-regex": "^10.6.0",
    "simple-icons": "^16.27.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "~3.0.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "onnxruntime-node@1.21.0": true,
    "sharp@0.34.5": true,
    "protobufjs@7.6.5": true
  }
}
